{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadChinese",
  "version": "0.1.0",
  "identifier": "io.github.readchinese.tauri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://shot.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../python/ocr_server.py": "python/ocr_server.py"
    }
  }
}
