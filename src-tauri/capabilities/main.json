{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Translator window: may use every app command except the capture overlay ones.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-get-config",
    "allow-set-config",
    "allow-get-langs",
    "allow-ai-presets",
    "allow-ai-new-id",
    "allow-ai-test",
    "allow-capture-backend",
    "allow-translate",
    "allow-start-capture",
    "allow-hide",
    "allow-pin",
    "allow-fit",
    "allow-copy",
    "allow-tts-edge"
  ]
}
